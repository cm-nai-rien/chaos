{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" pull --ff-only origin main 2>&1 | tail -3",
            "statusMessage": "Pulling latest from GitHub…",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
